{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "native/hotkey/index.d.ts",
    "packages/*/src/**/*"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
