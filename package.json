{
  "name": "jezo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first personal agent for todos, goals, calendar, and habits",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/native.ts && electron-vite dev",
    "build": "bun scripts/native.ts && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json && bun run check:i18n",
    "test": "bun test src/main",
    "e2e": "bun scripts/native.ts && electron-vite build && playwright test",
    "package": "bun scripts/native.ts && electron-vite build && electron-builder --dir",
    "check:i18n": "bun scripts/check-locales.ts",
    "postinstall": "electron-builder install-app-deps && bun scripts/native.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@jezo/hotkey": "file:native/hotkey",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "fflate": "0.8.3",
    "fractional-indexing": "^4.0.0",
    "i18next": "^26.4.2",
    "ical.js": "2.2.1",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "nanotar": "0.3.0",
    "opencc-js": "^1.4.2",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "typebox": "1.3.27",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "trustedDependencies": [
    "@jezo/hotkey"
  ]
}
